@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Bienvenidos!</h1>
    <p>Bienvenidos al sugeridor de recetas.</p>
</div>

<form action='@Url.Action("GenerarResultado", "Home")' method="GET" enctype="multipart/form-data">
    Nombre:                 <input type = "text" name = "nombre">               </br>
    Fecha de Nacimiento:    <input type = "date" name = "fechaNacimiento">      </br>
    Tipo de comid           <input type = "radio" name = "tipoComida" value = "Caliente">Caliente
                            <input type = "radio" name = "tipoComida" value = "Fría">Fría   </br>
    Presupuesto:            <input type = "number" name = "presupuesto" min = 1>            </br>
    Cantidad de Personas:   <input type = "number" name = "cantidad" min = 1 max = 20>      </br>
    <input type = "reset" name = "borrar">
    <input type = "submit" name = "entregar">
</form>